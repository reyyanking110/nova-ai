{
  "name": "nova-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web 'npm run dev -w @nova/api' 'npm run dev -w @nova/web'",
    "build": "npm run build -w @nova/shared && npm run build -w @nova/api && npm run build -w @nova/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "start": "npm run start -w @nova/api",
    "worker": "npm run worker -w @nova/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:browser": "node scripts/run-browser-check.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "playwright-core": "^1.65.0",
    "prettier": "^3.10.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
